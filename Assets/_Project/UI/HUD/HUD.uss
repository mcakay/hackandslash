.hud-container {
    width: 100%;
    height: 100%;
    position: absolute;
    justify-content: flex-end;
}

.bottom-bar {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    padding: 30px;
}

.left-panel {
    flex-direction: column;
    justify-content: flex-end;
}

.abilities-row {
    flex-direction: row;
    margin-bottom: 10px;
}

.ability-icon {
    width: 40px;
    height: 40px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 2px;
    margin-right: 10px;
    border-width: 2px;
    border-color: rgb(150, 150, 150);
    align-items: center;
    justify-content: center;
    position: relative;
}

.keybind-text {
    position: absolute;
    bottom: -15px;
    font-size: 10px;
    color: rgb(200, 200, 200);
    -unity-font-style: bold;
}

.cooldown-overlay {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 0%;
    background-color: rgba(0, 0, 0, 0.75);
}

.cooldown-text {
    position: absolute;
    font-size: 14px;
    color: white;
    -unity-font-style: bold;
    text-shadow: 1px 1px 0 rgba(0,0,0,1);
}

.health-container {
    flex-direction: row;
    align-items: center;
}

.health-bar-bg {
    width: 250px;
    height: 15px;
    background-color: rgb(40, 40, 40);
    border-radius: 5px;
    overflow: hidden;
}

.health-bar-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(200, 40, 40);
    transform-origin: left;
    transition: width 0.2s ease-out;
}

.health-text {
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
    margin-left: 10px;
}
